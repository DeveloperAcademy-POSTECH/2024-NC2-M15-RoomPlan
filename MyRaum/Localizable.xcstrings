    },
    "공개 여부는 직접 정합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide what is public"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 여부는 직접 정합니다"
          }
        }
      }
    },
    "공개하면 이 공간의 위치가 다른 사용자에게 함께 보입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Making it public also shows this space's location to other people."
