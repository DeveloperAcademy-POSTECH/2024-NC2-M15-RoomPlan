    },
    "두 손가락으로 돌려서 방향을 바꿔보세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twist with two fingers to rotate it."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 손가락으로 돌려서 방향을 바꿔보세요."
          }
        }
      }
    },
    "드래그해서 공간을 돌려보세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to rotate the space."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그해서 공간을 돌려보세요."
          }
        }
      }
    },
    "라이다 센서가 빛을 쏘아 벽, 문, 창문, 가구까지의 거리를 측정하고, 이를 바탕으로 공간의 3D 모델을 만듭니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The LiDAR sensor emits light to measure the distance to walls, doors, windows, and furniture, then builds a 3D model of the space."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이다 센서가 빛을 쏘아 벽, 문, 창문, 가구까지의 거리를 측정하고, 이를 바탕으로 공간의 3D 모델을 만듭니다."
          }
        }
      }
    },
    "라이다가 필요한 이유" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why LiDAR is needed"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이다가 필요한 이유"
          }
        }
      }
    },
    "라이트 모드" : {
      "localizations" : {
