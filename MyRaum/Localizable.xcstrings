{
  "sourceLanguage": "en",
  "strings": {
    " 지도": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도"
          }
        }
      }
    },
    " 카드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드"
          }
        }
      }
    },
    "2.0에서 스캔한 모든 공간은 계정에 함께 저장되어 기기를 바꿔도 복원됩니다. 위치 정보도 함께 저장됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every space you scan in 2.0 is saved to your account and restored when you change devices. Location data is saved along with it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2.0에서 스캔한 모든 공간은 계정에 함께 저장되어 기기를 바꿔도 복원됩니다. 위치 정보도 함께 저장됩니다."
          }
        }
      }
    },
    "3D 모델을 저장하지 못했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to save the 3D model."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 모델을 저장하지 못했습니다."
          }
        }
      }
    },
    "3D 모델의 각도를 조절한 후\n배경을 추가하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After adjusting the angle of the 3D model, add a background."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 모델의 각도를 조절한 후\n배경을 추가하세요."
          }
        }
      }
    },
    "Apple 로그인 정보를 받지 못했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not get your Apple sign-in details."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 로그인 정보를 받지 못했습니다."
          }
        }
      }
    },
