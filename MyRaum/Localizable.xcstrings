    "공간에 대해서 기록하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write about the space."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간에 대해서 기록하세요."
          }
        }
      }
    },
    "공간을 3D 모델로 남깁니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your space as a 3D model"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간을 3D 모델로 남깁니다"
          }
        }
      }
    },
    "공간을 천천히 둘러보며 벽과 가구를 비춰주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slowly look around the space and aim at the walls and furniture."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간을 천천히 둘러보며 벽과 가구를 비춰주세요."
          }
        }
      }
    },
    "공개": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public"
          }
        },
        "ko": {
          "stringUnit": {
