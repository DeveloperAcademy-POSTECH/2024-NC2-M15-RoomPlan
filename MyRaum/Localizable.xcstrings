    "서버 설정이 없어 로그인할 수 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in is unavailable because the server is not configured."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 설정이 없어 로그인할 수 없습니다."
          }
        }
      }
    },
    "서버 설정이 없어 업로드할 수 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload is unavailable because the server is not configured."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 설정이 없어 업로드할 수 없습니다."
          }
        }
      }
    },
    "서버에 저장된 공간이 모두 삭제되며 되돌릴 수 없습니다. 이 기기의 이전 카드는 남습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All spaces saved on the server will be deleted and cannot be recovered. Older cards on this device remain."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 저장된 공간이 모두 삭제되며 되돌릴 수 없습니다. 이 기기의 이전 카드는 남습니다."
          }
        }
      }
    },
